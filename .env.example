# ===== 本地开发（npm run dev）用 localhost 值 =====
# 依赖：本地已装 Chroma 容器（docker run -d -p 8000:8000 -v chroma-data:/data chromadb/chroma:latest）
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text
CHROMA_ENDPOINT=http://localhost:8000

# /admin 管理后台访问密码（无登录体系，靠这一道密码门）
# 本地 .env 与 服务器 deploy/docker-compose.server.yml 里的值必须一致
ADMIN_PASSWORD=你的管理密码

# ===== 服务器（docker-compose）由 compose 里的 environment 直接设置，无需在 .env 里重复 =====
# 上线前把 docker-compose.yml 的 OLLAMA_BASE_URL 改成 frp 暴露的地址，如 https://ollama.chensuipian02004.icu
